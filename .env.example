# --- LLM backend: Google Gemini (via its OpenAI-compatible endpoint) ---
# Put your Gemini API key in GEMINI_API_KEY to enable the real LLM evaluator.
# Left empty = offline demo mode: local hashing embeddings + rule-based reviewer.
GEMINI_API_KEY=
# Gemini's OpenAI-compatible endpoint. Override this (and use OPENAI_API_KEY)
# only when intentionally using another compatible provider.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CHAT_MODEL=gemini-4-argon
EMBEDDING_MODEL=gemini-embedding-001

# --- Storage ---
# SQLite database path (default: ./data/brandgovernance.db)
DATABASE_URL=sqlite:///./data/brandgovernance.db

# --- API ---
# Static admin API key required as `X-API-Key` on mutating endpoints.
ADMIN_API_KEY=dev-admin-key
# Top-K chunks passed to the reviewer per retrieval plan.
RETRIEVAL_TOP_K=12
REVIEW_CONTENT_MAX_CHARS=60000

# ── Secrets / local config ──────────────────────────────────────────────
# Real credentials live only in .env (never pushed). The tracked
# .env.example stays in sync as a placeholder-only template.
.env
.env.*
!.env.example

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# ── Test / coverage caches ──────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Runtime data (SQLite DBs, WAL/SHM files, uploaded documents) ────────
data/
*.db
*.db-*
*.sqlite
*.sqlite3
.data/

# ── App / platform state ────────────────────────────────────────────────
.freebuff/

# ── Logs & temp files ───────────────────────────────────────────────────
*.log
*.tmp
*.pid

# ── OS & editor cruft ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ── Node / frontend (exam-forge or similar) ─────────────────────────────
node_modules/
dist/
.vite/
npm-debug.log*